# Copy to .env.local (never commit .env.local).
# Supabase: Project Settings → API
# Use Project URL and the publishable/anon public client key (never the secret/service key).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production (Vercel / Netlify / etc.): set the same variables in the host’s Environment
# settings. Then in Supabase → Authentication → URL configuration, add your production
# site URL and redirect URLs (e.g. https://your-app.vercel.app/** and /login if needed).

# Skill Matrix → Report tab advisor (optional): deploy the Edge Function
# `supabase/functions/matrix-report-advisor` and set secret OPENAI_API_KEY on that function.
# On hosts other than localhost/127.0.0.1, the app posts to same-origin `/api/report-advisor`
# (Vercel serverless), which proxies to that function — avoids cross-origin "Failed to fetch".
# Set VITE_ADVISOR_PROXY=false to force direct invoke from the browser instead.
